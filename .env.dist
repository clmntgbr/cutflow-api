PORT=3000
GO_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=86400
RATE_LIMIT_MAX=100

###> postgres ###
POSTGRES_VERSION=16
POSTGRES_DB=db
POSTGRES_USER=random
POSTGRES_PASSWORD=random
POSTGRES_NAME=database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_NAME}:5432/${POSTGRES_DB}?sslmode=disable
###< postgres ###

###> ngrok/ngrok ###
NGROK_AUTHTOKEN=
###< ngrok/ngrok ###

###> clerk/clerk-go ###
CLERK_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=
###< clerk/clerk-go ###

###> rabbitmq ###
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/
RABBITMQ_EXCHANGE=domain.events
RABBITMQ_QUEUE=domain.events
RABBITMQ_ROUTING_KEY=user.#,project.#,media_file.#,job.#
RABBITMQ_RETRY_TTL_MS=30000
WORKER_MAX_RETRIES=3
OUTBOX_POLL_INTERVAL=2s
WORKER_CONCURRENCY=4
EXTRACTION_QUEUE=extraction
EXTRACTION_ROUTING_KEY=media_file.ready.v1
EXTRACTION_CONCURRENCY=5
SILENCE_QUEUE=silence
SILENCE_ROUTING_KEY=media_file.silence_requested.v1
SILENCE_CONCURRENCY=5
SILENCE_THRESHOLD_DB=-35
SILENCE_MIN_DURATION_MS=400
TRANSCRIPT_QUEUE=transcript
TRANSCRIPT_ROUTING_KEY=media_file.transcript_requested.v1
TRANSCRIPT_CONCURRENCY=5
ASSEMBLYAI_API_KEY=
TRANSCRIPT_USE_FIXTURES=true
TRANSCRIPT_FIXTURE_JSON=fixtures/transcript.json
ANALYSIS_QUEUE=analysis
ANALYSIS_ROUTING_KEY=media_file.analysis_requested.v1
ANALYSIS_CONCURRENCY=5
VIRAL_QUEUE=viral
VIRAL_ROUTING_KEY=media_file.viral_requested.v1
VIRAL_CONCURRENCY=2
VIRAL_LLM_PROVIDER=openai
VIRAL_LLM_MODEL=gpt-4o-mini
VIRAL_LLM_API_KEY=
VIRAL_LLM_BASE_URL=
VIRAL_CHUNK_DURATION_MS=600000
VIRAL_CHUNK_OVERLAP_MS=30000
TIMELINE_QUEUE=timeline
TIMELINE_ROUTING_KEY=media_file.timeline_rebuild_requested.v1
TIMELINE_CONCURRENCY=5
###< rabbitmq ###

###> centrifugo/centrifugo ###
CENTRIFUGO_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:3000 http://localhost:3001
CENTRIFUGO_PUBLIC_WS_URL=ws://localhost:8000/connection/websocket
###< centrifugo/centrifugo ###

###> s3 ###
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_INTERNAL_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=devuser
STORAGE_SECRET_KEY=devpassword
STORAGE_BUCKET=media
STORAGE_USE_PATH_STYLE=true
UPLOAD_URL_TTL=15m
EXPIRE_UPLOADS_INTERVAL=1m
MEDIA_MAX_SIZE_BYTES=2147483648
###< s3 ###

###> minio ###
MINIO_WEBHOOK_SECRET=dev-minio-webhook-secret
###< minio ###
